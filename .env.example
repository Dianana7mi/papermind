# Production Compose. Copy to .env and choose long random passwords/secrets.
PM_ENVIRONMENT=production
POSTGRES_DB=papermind
POSTGRES_USER=papermind
POSTGRES_PASSWORD=replace-with-long-random-password
PM_SECRET_KEY=replace-with-at-least-32-random-characters
PM_DATABASE_URL=postgresql+asyncpg://papermind:replace-with-long-random-password@postgres:5432/papermind
PM_REDIS_URL=redis://redis:6379/0
PM_QDRANT_URL=http://qdrant:6333
PM_STORAGE_PATH=/app/data
PM_TASK_EAGER=false
PM_CORS_ORIGINS=["http://localhost:3000"]
PM_PARSER=docling
PM_DOCLING_PIPELINE=standard
PM_DOCLING_CELL_MATCHING=false
PM_MAX_EXTRACTION_SOURCES=20
PM_BM25_MAX_DOCUMENTS=50000
PM_BM25_MAX_CHARACTERS=32000000
PM_BM25_CACHE_ENTRIES=2
PM_BASE_URL=https://api.openai.com/v1
PM_API_KEY=
PM_CHAT_MODEL=gpt-4.1-mini
PM_EMBEDDING_BACKEND=local
PM_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
PM_EMBEDDING_BASE_URL=https://api.openai.com/v1
PM_EMBEDDING_API_KEY=
PM_RERANKER_BACKEND=local
PM_RERANKER_MODEL=cross-encoder/ms-marco-TinyBERT-L2-v2
PM_RERANKER_URL=
PM_RERANKER_API_KEY=
PM_CONTEXT_LENGTH=16000
PM_MAX_INPUT_TOKENS=24000
PM_MAX_TOTAL_TOKENS=30000
PM_MAX_COST_USD=0.25
PM_TIMEOUT=90
PM_RETRIES=2
PM_AGENT_MAX_TOOLS=8
PM_AGENT_TIMEOUT=180
# Optional prices in USD per million tokens; empty means unknown, never zero cost.
# PM_INPUT_COST_PER_MILLION=
# PM_OUTPUT_COST_PER_MILLION=
PM_LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
PM_OPENALEX_API_KEY=
SITE_ADDRESS=localhost
